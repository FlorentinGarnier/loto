<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}{{ 'app.admin.loto.title'|trans }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('brand/quinou-icone.svg') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block head %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
    {% block scripts %}{% endblock %}
</body>
</html>
