{% extends 'admin/_layout.html.twig' %}

{% block title %}Parties – {{ event.name }}{% endblock %}

{% block admin_body %}
<div class="panel">
  <div class="panel__head">
    <h1>Parties – {{ event.name }} ({{ event.date|date('d/m/Y') }})</h1>
    <div class="row">
      <a href="{{ path('admin_event_index') }}" class="btn btn--small">Événements</a>
      <a href="{{ path('admin_game_new', {id: event.id}) }}" class="btn btn--primary btn--small">Nouvelle partie</a>
    </div>
  </div>
  {% if games is empty %}
    <p class="muted">Aucune partie définie pour cet événement.</p>
  {% else %}
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Ordre</th>
            <th>Règle</th>
            <th>Lot</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody
          data-controller="sortable"
          data-sortable-url-value="{{ path('admin_game_reorder', {id: event.id}) }}">
          {% for g in games %}
            <tr class="is-sortable" data-id="{{ g.id }}">
              <td class="data">#{{ g.position }}</td>
              <td>{{ g.rule.value }}</td>
              <td>{{ g.prize }}</td>
              <td><span class="pill pill--{{ g.status.value|lower }}">{{ g.status.value }}</span></td>
              <td>
                <div class="actions">
                  <a class="btn btn--small" href="{{ path('admin_game_edit', {id: event.id, gameId: g.id}) }}">Éditer</a>
                  <form class="inline-form" method="post" action="{{ path('admin_game_delete', {id: event.id, gameId: g.id}) }}" onsubmit="return confirm('Supprimer cette partie ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_game_' ~ g.id) }}" />
                    <button class="btn btn--danger btn--small">Supprimer</button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}
