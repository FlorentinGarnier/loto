{{ form_start(form, {attr: {class: 'form'}}) }}
    {{ form_row(form.name) }}
    {{ form_row(form.email) }}
    {{ form_row(form.phone) }}
    {{ form_row(form.event) }}
    {{ form_row(form.cards) }}
