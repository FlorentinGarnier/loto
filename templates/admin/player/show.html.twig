{% extends 'admin/_layout.html.twig' %}

{% block title %}Joueur #{{ player.id }}{% endblock %}

{% block admin_body %}
<div class="panel">
  <div class="panel__head">
    <h1>Joueur</h1>
    <div class="row">
      <a href="{{ path('admin_player_edit', {id: player.id}) }}" class="btn btn--primary btn--small">Éditer</a>
      <a href="{{ path('admin_player_index') }}" class="btn btn--small">Retour</a>
    </div>
  </div>
  <dl class="details">
    <div>
      <dt>Nom</dt>
      <dd>{{ player.name }}</dd>
    </div>
    <div>
      <dt>Email</dt>
      <dd>{{ player.email ?: '—' }}</dd>
    </div>
    <div>
      <dt>Téléphone</dt>
      <dd>{{ player.phone ?: '—' }}</dd>
    </div>
    <div>
      <dt>Événement</dt>
      <dd>{{ player.event.name ?: '—' }}</dd>
    </div>
    <div class="wide">
      <dt>Remarques</dt>
      <dd class="pre-line">{{ player.notes ?: '—' }}</dd>
    </div>
  </dl>

  <div class="section">
    <form method="post" action="{{ path('admin_player_delete', {id: player.id}) }}" onsubmit="return confirm('Supprimer ce joueur ?');">
      <input type="hidden" name="_token" value="{{ csrf_token('delete_player_' ~ player.id) }}" />
      <button class="btn btn--danger">Supprimer</button>
    </form>
  </div>
</div>
{% endblock %}
