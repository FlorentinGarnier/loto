{{ form_start(form, {attr: {class: 'form'}}) }}
    {{ form_row(form.position) }}
    {{ form_row(form.rule) }}
    {{ form_row(form.prize) }}
    {{ form_row(form.status) }}
    <div class="check">
        {{ form_widget(form.hallOnly) }}
        {{ form_label(form.hallOnly) }}
        {{ form_errors(form.hallOnly) }}
    </div>
    <div class="form__actions">
        <button class="btn btn--primary">Enregistrer</button>
        <a href="{{ path('admin_game_index', {id: event.id}) }}" class="btn">Annuler</a>
    </div>
{{ form_end(form) }}
