{% extends 'admin/_layout.html.twig' %}

{% block title %}Événements{% endblock %}

{% block admin_body %}
<div class="panel">
  <div class="panel__head">
    <h1>Événements</h1>
    <div class="row">
      <a href="{{ path('admin_event_new') }}" class="btn btn--primary btn--small">Nouvel événement</a>
    </div>
  </div>
  {% if events is empty %}
    <p class="muted">Aucun événement pour le moment.</p>
  {% else %}
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Nom</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for e in events %}
            <tr>
              <td>{{ e.name }}</td>
              <td class="data">{{ e.date|date('d/m/Y') }}</td>
              <td>
                <div class="actions">
                  <a class="btn btn--small" href="{{ path('admin_event_show', {id: e.id}) }}">Voir</a>
                  <a class="btn btn--small" href="{{ path('admin_game_index', {id: e.id}) }}">Parties</a>
                  <a class="btn btn--small" href="{{ path('admin_event_edit', {id: e.id}) }}">Éditer</a>
                  <form class="inline-form" method="post" action="{{ path('admin_event_delete', {id: e.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ e.id) }}" />
                    <button class="btn btn--danger btn--small">Supprimer</button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}
