{% extends 'admin/_layout.html.twig' %}

{% block title %}Cartons{% endblock %}

{% block admin_body %}
<div class="panel">
  <div class="panel__head">
    <h1>Cartons</h1>
    <div class="row">
      <a href="{{ path('admin_card_new') }}" class="btn btn--primary btn--small">Nouveau carton</a>
    </div>
  </div>
  <form method="get" class="search" style="margin-bottom: 16px">
    <input type="text" name="search" value="{{ search }}" placeholder="Rechercher par référence, joueur ou événement…" class="input" aria-label="Rechercher un carton" />
    <button type="submit" class="btn btn--dark">Rechercher</button>
    {% if search %}
      <a href="{{ path('admin_card_index') }}" class="btn">Réinitialiser</a>
    {% endif %}
  </form>

  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Événement</th>
          <th>Référence</th>
          <th>Joueur</th>
          <th>Grille</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for c in matrix %}
          <tr>
            <td class="data">{{ c.id }}</td>
            <td>{{ c.event ? c.event.name : '—' }}</td>
            <td class="data">{{ c.reference }}</td>
            <td>{{ c.player ? c.player.name : '—' }}</td>
            <td>
              <table class="loto-card">
                <tbody>
                {% for line in c.grid %}
                  <tr>
                    {% for col in 0..8 %}
                      <td class="{{ line[col] is defined ? '' : 'is-empty' }}">{{ line[col] ?? '.' }}</td>
                    {% endfor %}
                  </tr>
                {% endfor %}
                </tbody>
              </table>
            </td>
            <td>
              <div class="actions">
                <a href="{{ path('admin_card_edit', {id: c.id}) }}" class="btn btn--small">Éditer</a>
                <form method="post" action="{{ path('admin_card_delete', {id: c.id}) }}" class="inline-form" onsubmit="return confirm('Supprimer ce carton ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_card_' ~ c.id) }}" />
                  <button class="btn btn--danger btn--small">Supprimer</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td class="empty" colspan="6">Aucun carton.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if totalPages > 1 %}
    <div class="pagination">
      <div class="muted">
        Total : {{ totalItems }} carton{{ totalItems > 1 ? 's' : '' }}
      </div>
      <div class="pagination__pages">
        {% if currentPage > 1 %}
          <a href="{{ path('admin_card_index', {page: currentPage - 1, search: search}) }}">&laquo; Précédent</a>
        {% endif %}

        {% for p in 1..totalPages %}
          {% if p == currentPage %}
            <span class="is-current" aria-current="page">{{ p }}</span>
          {% elseif (p >= currentPage - 2 and p <= currentPage + 2) or p == 1 or p == totalPages %}
            <a href="{{ path('admin_card_index', {page: p, search: search}) }}">{{ p }}</a>
          {% elseif p == currentPage - 3 or p == currentPage + 3 %}
            <span class="gap">…</span>
          {% endif %}
        {% endfor %}

        {% if currentPage < totalPages %}
          <a href="{{ path('admin_card_index', {page: currentPage + 1, search: search}) }}">Suivant &raquo;</a>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>
{% endblock %}
