{% extends 'admin/_layout.html.twig' %}

{% block title %}Joueurs{% endblock %}

{% block admin_body %}
<div class="panel">
  <div class="panel__head">
    <h1>Joueurs</h1>
    <div class="row">
      <a href="{{ path('admin_player_new') }}" class="btn btn--primary btn--small">Nouveau joueur</a>
    </div>
  </div>
  <form method="get" class="search" style="margin-bottom: 16px">
    <input type="search" name="search" value="{{ search }}" placeholder="Rechercher par nom, courriel ou téléphone…" class="input" aria-label="Rechercher un joueur" />
    <button type="submit" class="btn btn--dark">Rechercher</button>
    {% if search %}
      <a href="{{ path('admin_player_index') }}" class="btn">Réinitialiser</a>
    {% endif %}
  </form>
  <p class="muted" style="margin-bottom: 8px">{{ players|length }} joueur{{ players|length > 1 ? 's' : '' }}{{ search ? ' pour « ' ~ search ~ ' »' : '' }}</p>

  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Cartons</th>
          <th>Email</th>
          <th>Téléphone</th>
          <th>Événement</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for p in players %}
          <tr>
            <td>{{ p.name }}</td>
            <td class="data">{{ p.cards|length }}</td>
            <td>{{ p.email ?: '—' }}</td>
            <td class="data">{{ p.phone ?: '—' }}</td>
            <td>{{ p.event.name ?: '—' }}</td>
            <td>
              <div class="actions">
                <a href="{{ path('admin_player_show', {id: p.id}) }}" class="btn btn--small">Voir</a>
                <a href="{{ path('admin_player_edit', {id: p.id}) }}" class="btn btn--small">Éditer</a>
                <form method="post" action="{{ path('admin_player_delete', {id: p.id}) }}" class="inline-form" onsubmit="return confirm('Supprimer ce joueur ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_player_' ~ p.id) }}" />
                  <button class="btn btn--danger btn--small">Supprimer</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td class="empty" colspan="6">{{ search ? 'Aucun joueur ne correspond à cette recherche.' : 'Aucun joueur pour le moment.' }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
