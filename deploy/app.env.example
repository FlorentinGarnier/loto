# /srv/<appli>/<environnement>/app.env : variables de l'application (mode 600). Propres à chaque environnement.
APP_ENV=prod
APP_DEBUG=0
# openssl rand -hex 32
APP_SECRET=
DATABASE_URL=postgresql://appli:REMPLACER@database:5432/appli?serverVersion=16&charset=utf8
DEFAULT_URI=https://staging.example.com
# Réseau réel de Traefik
TRUSTED_PROXIES=172.16.0.0/12
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Staging : transport nul ou capture, jamais de vrais envois.
MAILER_DSN=null://null
# Mot de passe du compte admin : php bin/console security:hash-password (entre apostrophes, le hachage contient des $)
ADMIN_PASSWORD_HASH=
# Hub Mercure : adresse interne pour publier, adresse publique pour les navigateurs.
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://staging.example.com/.well-known/mercure
# openssl rand -hex 32 ; même valeur que les deux clés de mercure.env
MERCURE_JWT_SECRET=
