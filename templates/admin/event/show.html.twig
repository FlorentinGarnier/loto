{% extends 'admin/_layout.html.twig' %}

{% block title %}Événement {{ event.name }}{% endblock %}

{% block admin_body %}
<div class="panel">
  <div class="panel__head">
    <h1>{{ event.name }}</h1>
    <div class="row">
      <a href="{{ path('admin_event_index') }}" class="btn btn--small">Retour</a>
    </div>
  </div>
  <dl class="details">
    <div>
      <dt>Nom</dt>
      <dd>{{ event.name }}</dd>
    </div>
    <div>
      <dt>Date</dt>
      <dd>{{ event.date|date('d/m/Y') }}</dd>
    </div>
  </dl>

  <div class="section row">
    <a class="btn btn--primary" href="{{ path('admin_game_index', {id: event.id}) }}">Gérer les parties</a>
    <a class="btn btn--dark" href="{{ path('admin_event_export_winners', {id: event.id}) }}">Exporter les gagnants (CSV)</a>
  </div>

  <div class="section section--ruled">
    <h2>Remises à zéro</h2>
    <div class="row">
      <form method="post" action="{{ path('admin_event_reset_all_draws', {id: event.id}) }}" onsubmit="return confirm('Confirmer la remise à zéro de tous les tirages de cet événement ?');">
        <button type="submit" class="btn btn--danger">Réinitialiser tous les tirages</button>
      </form>
      <form method="post" action="{{ path('admin_event_reset_all_winners', {id: event.id}) }}" onsubmit="return confirm('Confirmer la suppression de tous les gagnants de cet événement ?');">
        <button type="submit" class="btn btn--danger">Supprimer tous les gagnants</button>
      </form>
      <form method="post" action="{{ path('admin_event_unassign_all_players', {id: event.id}) }}" onsubmit="return confirm('Confirmer la désassociation de tous les joueurs des cartons ?');">
        <button type="submit" class="btn btn--danger">Désassocier tous les joueurs</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
