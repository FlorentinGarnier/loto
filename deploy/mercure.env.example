# /srv/<appli>/<environnement>/mercure.env : variables du hub Mercure (mode 600).
# Même valeur que MERCURE_JWT_SECRET dans app.env.
MERCURE_PUBLISHER_JWT_KEY=REMPLACER
MERCURE_SUBSCRIBER_JWT_KEY=REMPLACER
# anonymous : l'écran public et le tableau de bord s'abonnent sans jeton.
MERCURE_EXTRA_DIRECTIVES="anonymous
cors_origins https://staging.example.com"
