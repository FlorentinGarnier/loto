{% extends 'admin/_layout.html.twig' %}

{% block title %}Éditer la partie – {{ event.name }}{% endblock %}

{% block admin_body %}
<div class="panel">
  <div class="panel__head">
    <h1>Éditer la partie – {{ event.name }}</h1>
    <div class="row">
      <a href="{{ path('admin_game_index', {id: event.id}) }}" class="btn btn--small">Retour</a>
    </div>
  </div>
  {% include 'admin/game/_form.html.twig' with {form: form, event: event} %}
</div>
{% endblock %}
