{% extends 'base.html.twig' %}

{# Jeton des actions d'administration, lu par le JavaScript (assets/csrf.js) #}
{% block head %}
    <meta name="csrf-token" content="{{ csrf_token('admin_action') }}">
{% endblock %}

{% block body %}
  {% set route = app.request.attributes.get('_route') %}
  <div class="page">
    <nav class="topbar" aria-label="Navigation principale">
      <a class="topbar__logo" href="{{ path('admin_dashboard') }}">
        <img src="{{ asset('brand/quinou-logo.svg') }}" alt="Quinou">
      </a>
      <div class="topbar__links">
        <a href="{{ path('admin_dashboard') }}" class="{{ route starts with 'admin_dashboard' ? 'is-active' }}">Tableau de bord</a>
        <a href="{{ path('admin_event_index') }}" class="{{ route starts with 'admin_event_' ? 'is-active' }}">Événements</a>
        {# Lien Parties: nécessite un événement. On utilise event si dispo, sinon current.event si dispo, sinon les parties de l'événement courant #}
        {% set gamesHref = null %}
        {% if event is defined and event %}
          {% set gamesHref = path('admin_game_index', {id: event.id}) %}
        {% elseif current is defined and current and current.event %}
          {% set gamesHref = path('admin_game_index', {id: current.event.id}) %}
        {% endif %}
        <a href="{{ gamesHref ?? path('admin_game_current') }}" class="{{ route starts with 'admin_game_' ? 'is-active' }}">Parties</a>
        <a href="{{ path('admin_card_index') }}" class="{{ route starts with 'admin_card_' ? 'is-active' }}">Cartons</a>
        <a href="{{ path('admin_player_index') }}" class="{{ route starts with 'admin_player_' ? 'is-active' }}">Joueurs</a>
        <a href="{{ path('app_logout') }}">Déconnexion</a>
      </div>
    </nav>

    <div class="stack stack--tight">
      {% include 'admin/_flashes.html.twig' %}
    </div>

    {% block admin_body %}{% endblock %}
  </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    {{ importmap('app') }}
{% endblock %}
